# =========================================================
# GR AUTO MODIFICATION SYSTEM - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# =========================================================

# --- Flask core ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-value
WTF_CSRF_ENABLED=1

# --- Database ---
# SQLite for local dev. Swap to a PostgreSQL URL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/gr_auto_mod
DATABASE_URL=sqlite:///gr_auto_mod.db

# --- Upstream API base ---
API_BASE_URL=https://load.omone.in/utility-service/api

# --- Authenticated session layer ---
# The upstream system requires an authenticated session/cookie or bearer
# token. Populate exactly ONE of these depending on how the upstream
# system authenticates. NEVER hardcode these values in source code.
API_AUTH_MODE=none
# API_AUTH_MODE=bearer | cookie | none
API_BEARER_TOKEN=
API_SESSION_COOKIE=

# --- HTTP behaviour ---
API_REQUEST_TIMEOUT_SECONDS=15
API_RETRY_COUNT=3
API_RETRY_BACKOFF_BASE_SECONDS=1.5
API_RATE_LIMIT_PER_SECOND=5

# --- Bulk processing ---
BULK_CONCURRENCY=4
MAX_EXCEL_ROWS=5000

# --- SAVE / MODIFICATION API (UNKNOWN - CONFIGURE WHEN AVAILABLE) ---
# Until these are set, the app runs in Preview/Dry-Run mode only.
# See services/modification_service.py -> save_modification() for the
# exact place this configuration is consumed.
SAVE_API_ENABLED=false
SAVE_API_URL=
SAVE_API_METHOD=POST
SAVE_API_AUTH_MODE=none

# Fields to never echo back in a save payload even though the rest of the
# original CN record is preserved. manualCnNo/cnMamualCnDate are excluded
# by default (see services/modification_service.py for why). Add more,
# comma-separated, if another field turns out to cause similar problems.
SAVE_PAYLOAD_EXTRA_EXCLUDED_FIELDS=

# --- Login / permissions (used by the auth layer: routes/auth.py) ---
# Reuses API_BASE_URL above for /manual-cn/login and
# /manual-cn/allowbulk/{branchCode} - no separate URL needed unless your
# login service lives on a different host.

# --- Gemini AI copilot (advisory only - services/ai_service.py) ---
# Leave GEMINI_API_KEY blank to run with the AI panel disabled; every
# other feature works identically either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=10

# --- Freight Mode / Transport Mode dropdown option labels ---
# The real code-to-label mapping (e.g. which integer means "TO PAY") has
# not been confirmed against the live upstream code table. Configure as a
# JSON array once confirmed, e.g.:
# FREIGHT_MODE_OPTIONS=[{"value":"5","label":"TO BILL(CNR)"},{"value":"1","label":"PREPAID"}]
FREIGHT_MODE_OPTIONS=
TRANSPORT_MODE_OPTIONS=

# --- File storage ---
UPLOAD_FOLDER=uploads
EXPORT_FOLDER=exports
