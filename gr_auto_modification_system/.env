# =========================================================
# GR AUTO MODIFICATION SYSTEM - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# =========================================================

# --- Flask core ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-value
WTF_CSRF_ENABLED=1

# --- Operator login session ---
# Minutes an authenticated operator session stays valid (rolling window -
# refreshed on activity). Login is per-employee via the official
# /manual-cn/login API - see services/auth_service.py and routes/auth.py.
SESSION_LIFETIME_MINUTES=480

# --- Database ---
# SQLite for local dev. Swap to a PostgreSQL URL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/gr_auto_mod
DATABASE_URL=sqlite:///gr_auto_mod.db

# --- Upstream API base ---
API_BASE_URL=https://load.omone.in/utility-service/api

# --- Authenticated session layer ---
# The upstream system requires an authenticated session/cookie or bearer
# token. Populate exactly ONE of these depending on how the upstream
# system authenticates. NEVER hardcode these values in source code.
API_AUTH_MODE=none
# API_AUTH_MODE=bearer | cookie | none
API_BEARER_TOKEN=
API_SESSION_COOKIE=

# --- HTTP behaviour ---
API_REQUEST_TIMEOUT_SECONDS=15
API_RETRY_COUNT=3
API_RETRY_BACKOFF_BASE_SECONDS=1.5
API_RATE_LIMIT_PER_SECOND=5

# --- Bulk processing ---
BULK_CONCURRENCY=4
MAX_EXCEL_ROWS=5000

# --- SAVE / MODIFICATION API ---
# The known official endpoint is PUT /manual-cn/modification/{cn_no} - the
# default below already matches it ("{cn_no}" is substituted at call time).
# SAVE_API_ENABLED still defaults to false: until you explicitly set it to
# true here, the app runs in Preview/Dry-Run mode only and NO real upstream
# write is ever made, regardless of what a user clicks in the UI.
# See services/modification_service.py -> save_modification().
SAVE_API_ENABLED=true
SAVE_API_URL=/manual-cn/modification/{cn_no}
SAVE_API_METHOD=PUT
SAVE_API_AUTH_MODE=none

# --- File storage ---
UPLOAD_FOLDER=uploads
EXPORT_FOLDER=exports
