# Mail (SMTP/IMAP) aur AI (Gemini/Anthropic) credentials ab yahan .env mein NAHI
# aate — har user apni khud ki details app ke andar "My Settings" (/settings)
# page se bharta hai, aur wo encrypted DB mein save hoti hain. Neeche sirf woh
# values hain jo poori app ke liye ek baar (server-level) set karni hain.

# Session cookies sign karne ke liye — koi bhi lamba random string.
FLASK_SECRET=replace-with-a-long-random-secret

# OM Automation module (GST/CN/Party lookup) — session signing key for the
# GST-captcha flow. Falls back to a dev default if unset; set a real random
# value in production.
SECRET_KEY=replace-with-a-long-random-secret

# Har user ka SMTP password / IMAP password / AI API key isi key se encrypt
# hoke DB mein save hota hai. Render par render.yaml khud generate kar deta
# hai (generateValue: true) — local run ke liye koi bhi lamba random string
# de sakte hain. IMPORTANT: production mein set hone ke baad ise kabhi mat
# badlein, warna sabka saved data unreadable ho jayega.
CREDENTIALS_KEY=replace-with-a-long-random-secret

# AI model names (optional — konsa model use hoga; API KEY nahi, sirf naam).
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional — set karo to Postgres use hoga (production/Render), warna
# local SQLite file (data/app.db) use hoti hai (zero-setup local dev).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional — dashboard par "GR Auto Modification System" tile ko active
# karne ke liye us service ka URL (apna alag login hai, khulega naye tab
# mein). Khaali chhodne par tile "Link Pending" dikhata hai.
# GR_AUTO_URL=https://gr-auto-modification-system.onrender.com
